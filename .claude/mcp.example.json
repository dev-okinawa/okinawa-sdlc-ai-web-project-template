{
  "_readme": "Copy this file to your MCP client config. Replace /home/user/dev/project with your actual project root.",
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "/home/user/dev/project"
      ]
    }
  }
}
